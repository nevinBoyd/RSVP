# Copy this file to .env.local and fill in your own Supabase project's
# values (Supabase Dashboard → Project Settings → API). .env.local is
# gitignored (see *.local in .gitignore) — never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
